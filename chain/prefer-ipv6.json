{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": false
  },
  "http_clients": [
    {
      "tag": "rule-set-http"
    }
  ],
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:20123",
      "external_ui_download_detour": "🎯 全球直连",
      "secret": "CHANGE_ME_BEFORE_USE",
      "default_mode": "rule",
      "access_control_allow_private_network": false
    },
    "cache_file": {
      "enabled": true,
      "path": "cache.db"
    }
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 12345
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "172.18.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1420,
      "dns_mode": "hijack",
      "auto_route": true,
      "strict_route": true,
      "auto_redirect": true,
      "include_uid": [],
      "exclude_uid": []
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🧭 机场节点",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🔗 前置节点",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🇭🇰 香港",
        "🇹🇼 台湾",
        "🇸🇬 新加坡",
        "🇯🇵 日本",
        "🇰🇷 韩国",
        "🇺🇸 美国"
      ]
    },
    {
      "type": "selector",
      "tag": "🚀 落地节点",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇭🇰 香港",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇹🇼 台湾",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇸🇬 新加坡",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇯🇵 日本",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇰🇷 韩国",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇺🇸 美国",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "direct",
      "tag": "🎯 全球直连"
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 落地节点",
        "🎯 全球直连"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "tproxy-in",
          "tun-in"
        ]
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "reject",
        "protocol": "quic"
      },
      {
        "action": "route",
        "clash_mode": "direct",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "outbound": "GLOBAL"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-Private"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoIP-Private"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-CN"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoIP-CN"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-!CN"
        ],
        "outbound": "🚀 落地节点"
      }
    ],
    "rule_set": [
      {
        "tag": "GeoIP-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/privateip.srs",
        "format": "binary"
      },
      {
        "tag": "GeoSite-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/private.srs",
        "format": "binary"
      },
      {
        "tag": "GeoIP-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/cnip.srs",
        "format": "binary"
      },
      {
        "tag": "GeoSite-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/cn.srs",
        "format": "binary"
      },
      {
        "tag": "GeoLocation-!CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/DustinWin/ruleset_geodata@sing-box-ruleset/proxy.srs",
        "format": "binary"
      }
    ],
    "default_http_client": "rule-set-http",
    "auto_detect_interface": true,
    "final": "🚀 落地节点",
    "default_domain_resolver": {
      "server": "Local-DNS"
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "Local-DNS",
        "type": "local"
      },
      {
        "tag": "Remote-DNS",
        "type": "tls",
        "detour": "🚀 落地节点",
        "server_port": 853,
        "server": "8.8.8.8"
      }
    ],
    "rules": [
      {
        "action": "route",
        "clash_mode": "direct",
        "server": "Local-DNS"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "server": "Remote-DNS"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-CN"
        ],
        "server": "Local-DNS"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-!CN"
        ],
        "server": "Remote-DNS"
      },
      {
        "action": "evaluate",
        "server": "Local-DNS"
      },
      {
        "match_response": true,
        "ip_is_private": true,
        "action": "respond"
      },
      {
        "match_response": true,
        "rule_set": [
          "GeoIP-CN"
        ],
        "action": "respond"
      }
    ],
    "final": "Remote-DNS",
    "reverse_mapping": true,
    "strategy": "prefer_ipv6"
  },
  "endpoints": []
}
