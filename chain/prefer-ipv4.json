{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    }
  },
  "inbounds": [
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "::",
      "listen_port": 6053
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "::",
      "listen_port": 6054
    },
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 6055,
      "udp_fragment": true
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 9000,
      "auto_route": false,
      "strict_route": false,
      "dns_mode": "disabled"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🧭 机场节点",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🔗 前置节点",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🇭🇰 香港",
        "🇹🇼 台湾",
        "🇸🇬 新加坡",
        "🇯🇵 日本",
        "🇺🇸 美国"
      ]
    },
    {
      "type": "selector",
      "tag": "🚀 落地节点",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇭🇰 香港",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇹🇼 台湾",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇸🇬 新加坡",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇯🇵 日本",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "🇺🇸 美国",
      "interrupt_exist_connections": true,
      "outbounds": []
    },
    {
      "type": "direct",
      "tag": "🎯 全球直连"
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 落地节点",
        "🎯 全球直连"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "inbound": [
          "dns-in",
          "tun-in",
          "redirect-in",
          "tproxy-in"
        ]
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "action": "reject",
        "protocol": "quic"
      },
      {
        "action": "route",
        "clash_mode": "direct",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "outbound": "GLOBAL"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-Private"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoIP-Private"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-CN"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-CN"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoIP-CN"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-!CN"
        ],
        "outbound": "🚀 落地节点"
      }
    ],
    "rule_set": [
      {
        "tag": "GeoLocation-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-cn.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      },
      {
        "tag": "GeoIP-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      },
      {
        "tag": "GeoSite-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      },
      {
        "tag": "GeoIP-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      },
      {
        "tag": "GeoSite-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      },
      {
        "tag": "GeoLocation-!CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "format": "binary",
        "http_client": {
          "detour": "🚀 落地节点"
        }
      }
    ],
    "auto_detect_interface": true,
    "final": "🚀 落地节点",
    "default_domain_resolver": {
      "server": "Local-DNS"
    }
  },
  "dns": {
    "servers": [
      {
        "tag": "Local-DNS",
        "type": "tls",
        "server_port": 853,
        "server": "223.5.5.5"
      },
      {
        "tag": "Remote-DNS",
        "type": "tls",
        "detour": "🚀 落地节点",
        "server_port": 853,
        "server": "8.8.8.8"
      },
      {
        "tag": "fake-ip-dns-server",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-CN"
        ],
        "server": "Local-DNS"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-CN"
        ],
        "server": "Local-DNS"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoLocation-!CN"
        ],
        "server": "Remote-DNS"
      },
      {
        "action": "evaluate",
        "server": "Remote-DNS"
      },
      {
        "match_response": true,
        "ip_is_private": true,
        "action": "respond"
      },
      {
        "match_response": true,
        "rule_set": [
          "GeoIP-CN"
        ],
        "action": "respond"
      },
      {
        "action": "route",
        "server": "Remote-DNS"
      }
    ],
    "final": "Remote-DNS",
    "reverse_mapping": true,
    "strategy": "prefer_ipv4"
  },
  "endpoints": []
}
